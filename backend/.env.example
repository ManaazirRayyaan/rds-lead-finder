# Google Maps Platform key with "Places API (New)" enabled. Keep it server-side only.
GOOGLE_MAPS_API_KEY=your-google-api-key

# Local PostgreSQL via the current OS user. Render provides its own postgres:// URL.
DATABASE_URL=postgresql+psycopg:///rds_lead_finder

# Local Vite development origin. Production is same-origin in the Docker image.
CORS_ORIGINS=http://localhost:5173

# Run `python scripts/generate_auth_config.py --write-env` after copying this file.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=replace-with-generated-argon2-hash
SESSION_SECRET=replace-with-generated-64-character-secret
SESSION_HOURS=12

# False for local HTTP; Render sets this to true for HTTPS.
AUTH_COOKIE_SECURE=false
ENABLE_API_DOCS=true
